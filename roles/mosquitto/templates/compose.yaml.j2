services:
  mosquitto:
    image: eclipse-mosquitto:2
    container_name: mosquitto
    restart: unless-stopped

    volumes:
      - ./config:/mosquitto/config
      - ./data:/mosquitto/data
      - ./log:/mosquitto/log

    networks:
      - shared

    ports:
      - "127.0.0.1:1883:1883"
      - "127.0.0.1:9001:9001"

    expose:
      - "9001"

networks:
  shared:
    external: true
    name: "{{ shared_network_name }}"
