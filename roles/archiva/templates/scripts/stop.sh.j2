#!/bin/bash

set -euo pipefail

ARCHIVA_PROJECT_DIR="{{ archiva_project_dir }}"
INFRASTRUCTURE_PROJECT_DIR="{{ infrastructure_project_dir }}"
NGINX_LOCATION_FILE="{{ archiva_nginx_location_file }}"

echo "Deactivate the Archiva route in shared Nginx"
rm -f "${NGINX_LOCATION_FILE}"

cd "${INFRASTRUCTURE_PROJECT_DIR}"
if docker compose ps --status running nginx --format json 2>/dev/null | grep -q '"Service":"nginx"'; then
    docker compose exec -T nginx nginx -t
    docker compose exec -T nginx nginx -s reload
else
    echo "Shared Nginx is not running; route symlink has still been removed."
fi

echo "Change to the Archiva project directory"
cd "${ARCHIVA_PROJECT_DIR}"

echo "Stop the Archiva stack"
docker compose down
