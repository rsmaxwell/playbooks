#!/usr/bin/env bash

set -euo pipefail

# Follow Ledger production logs.
#
# Usage:
#   logs.sh                 Follow all Compose services.
#   logs.sh <service>       Follow one Compose service.
#   logs.sh requests        Follow completed API requests.
#   logs.sh nginx-errors    Follow the active frontend Nginx error log.

PROJECT_DIR="{{ ledger_project_dir }}"
COMPOSE_FILE="${PROJECT_DIR}/compose.yaml"
ENV_FILE="${PROJECT_DIR}/.env"
FRONTEND_MODE="{{ ledger_frontend_mode }}"

show_usage() {
    cat >&2 <<USAGE
Usage: $(basename -- "$0") [requests|nginx-errors|service]

With no argument, follows logs from all Ledger Compose services.
A Compose service name may also be supplied, for example:
  $(basename -- "$0") ledger-server
  $(basename -- "$0") ledger-client

Special views:
  requests      Follow completed client API requests and status/timing
  nginx-errors  Follow the active frontend Nginx error log

Available services:
USAGE
    docker compose --file "${COMPOSE_FILE}" --env-file "${ENV_FILE}" config --services >&2
}

if [[ ! -f "${COMPOSE_FILE}" || ! -f "${ENV_FILE}" ]]; then
    echo "ERROR: Ledger runtime files are incomplete under ${PROJECT_DIR}." >&2
    exit 1
fi

cd "${PROJECT_DIR}"
docker compose --file "${COMPOSE_FILE}" --env-file "${ENV_FILE}" config --quiet

if [[ $# -gt 1 ]]; then
    show_usage
    exit 1
fi

if [[ $# -eq 0 ]]; then
    docker compose --file "${COMPOSE_FILE}" --env-file "${ENV_FILE}" logs --follow --tail 200
    exit 0
fi

VIEW="$1"
case "${VIEW}" in
    requests)
        if [[ "${FRONTEND_MODE}" == "shared" ]]; then
            API_LOG="{{ ledger_shared_frontend_api_log }}"
        else
            API_LOG="${PROJECT_DIR}/logs/nginx/api-access.log"
        fi
        echo "Following Ledger API requests: ${API_LOG}"
        echo "Press Ctrl-C to stop."
        tail --lines=200 --follow=name --retry "${API_LOG}"
        ;;
    nginx-errors)
        if [[ "${FRONTEND_MODE}" == "shared" ]]; then
            ERROR_LOG="{{ ledger_shared_frontend_error_log }}"
        else
            ERROR_LOG="${PROJECT_DIR}/logs/nginx/error.log"
        fi
        echo "Following Ledger Nginx errors: ${ERROR_LOG}"
        echo "Press Ctrl-C to stop."
        tail --lines=200 --follow=name --retry "${ERROR_LOG}"
        ;;
    -h|--help|help)
        show_usage
        ;;
    *)
        if ! docker compose --file "${COMPOSE_FILE}" --env-file "${ENV_FILE}" config --services | grep -Fxq "${VIEW}"; then
            echo "ERROR: Unknown Ledger log view or service: ${VIEW}" >&2
            show_usage
            exit 1
        fi
        docker compose --file "${COMPOSE_FILE}" --env-file "${ENV_FILE}" logs --follow --tail 200 "${VIEW}"
        ;;
esac
