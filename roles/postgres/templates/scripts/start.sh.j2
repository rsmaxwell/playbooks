#!/bin/bash

 


echo "Change to the postgres project directory" 
cd "{{ postgres_project_dir }}" || {
    echo "Error: $0[${LINENO}]"
    exit 2
}


echo "Start the postgres stack"
output=$(docker compose up -d 2>&1)
result=$?
if [ "${result}" -ne 0 ]; then
    echo "Error starting postgres"
    echo "${output}"
    exit 0
fi




exit 1

