DIARIES_NAS_HOST={{ diaries_nas_host }}
DIARIES_NAS_SHARE={{ diaries_nas_share }}
DIARIES_NAS_USERNAME={{ diaries_nas_username }}
DIARIES_NAS_PASSWORD={{ diaries_nas_password }}
DIARIES_NAS_CONTENT_PATH={{ diaries_nas_content_path }}
DIARIES_FILES_DIR={{ diaries_files_dir }}

DIARIES_COMPLETE_BACKUP_REPOSITORY_ROOT={{ diaries_complete_backup_repository_root }}
DIARIES_COMPLETE_RESTORE_STATE_ROOT={{ diaries_complete_restore_state_root }}
DIARIES_COMPLETE_BACKUP_PUBLISHED_ROOT={{ diaries_complete_backup_published_root }}
DIARIES_COMPLETE_BACKUP_STORAGE_MODE={{ diaries_complete_backup_storage_mode }}

# 0036 controlled fixed-path production capture.
DIARIES_0036_FIXED_CAPTURE_ENABLED={{ diaries_fixed_capture_enabled | bool | lower }}
DIARIES_0036_HOST_MOUNT_ROOT={{ diaries_host_nas_mount_root }}
DIARIES_0036_HOST_FILES_ROOT={{ diaries_host_nas_mount_root }}/{{ diaries_nas_content_path | trim('/') }}/{{ diaries_files_dir }}
DIARIES_0036_HOST_FILES_IDENTITY={{ diaries_nas_content_path | trim('/') }}/{{ diaries_files_dir }}

DIARIES_MQTT_HEALTH_USERNAME={{ mosquitto_health_username }}
DIARIES_MQTT_HEALTH_PASSWORD={{ mosquitto_health_password }}

DIARIES_DB_NAME={{ diaries_db_name }}
DIARIES_DB_USERNAME={{ diaries_db_username }}
DIARIES_DB_PASSWORD={{ diaries_db_password }}

{% if diaries_frontend_mode == 'standalone' and diaries_cloudflare_tunnel_enabled | bool %}
CLOUDFLARE_TUNNEL_TOKEN={{ diaries_cloudflare_tunnel_token }}
{% endif %}
