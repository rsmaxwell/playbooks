#!/usr/bin/env bash

set -euo pipefail

# Stop the installed Diaries production stack.
#
# In shared frontend mode the Nginx route is removed before the application
# containers are stopped so the shared infrastructure configuration never
# points at services which are deliberately offline.

PROJECT_DIR="{{ diaries_project_dir }}"
COMPOSE_FILE="${PROJECT_DIR}/compose.yaml"
ENV_FILE="${PROJECT_DIR}/.env"
FRONTEND_MODE="{{ diaries_frontend_mode }}"
SHARED_NGINX_CONTAINER="{{ diaries_shared_frontend_nginx_container_name }}"
SHARED_LOCATION_FILE="{{ diaries_shared_frontend_location_file }}"

if [[ ! -f "${COMPOSE_FILE}" ]]; then
    echo "ERROR: Diaries Compose file not found: ${COMPOSE_FILE}" >&2
    exit 1
fi
if [[ ! -f "${ENV_FILE}" ]]; then
    echo "ERROR: Diaries environment file not found: ${ENV_FILE}" >&2
    exit 1
fi

if [[ "${FRONTEND_MODE}" == "shared" ]]; then
    echo "Deactivating Diaries routes in shared Nginx..."
    rm -f "${SHARED_LOCATION_FILE}"

    if docker inspect -f '{% raw %}{{.State.Running}}{% endraw %}' "${SHARED_NGINX_CONTAINER}" 2>/dev/null | grep -qx 'true'; then
        docker exec "${SHARED_NGINX_CONTAINER}" nginx -t
        docker exec "${SHARED_NGINX_CONTAINER}" nginx -s reload
    else
        echo "Shared Nginx is not running; the Diaries route symlink was still removed."
    fi
fi

cd "${PROJECT_DIR}"
echo "Stopping Diaries services..."
docker compose --file "${COMPOSE_FILE}" --env-file "${ENV_FILE}" down --remove-orphans

echo "Diaries stack stopped successfully."
