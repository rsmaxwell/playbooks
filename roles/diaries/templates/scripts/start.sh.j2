#!/usr/bin/env bash

set -euo pipefail

# Start the installed Diaries production stack.
#
# In shared frontend mode the application containers are started first, then
# the Diaries route is activated in the infrastructure Nginx only after the
# Compose services have reached their health checks.

PROJECT_DIR="{{ diaries_project_dir }}"
COMPOSE_FILE="${PROJECT_DIR}/compose.yaml"
ENV_FILE="${PROJECT_DIR}/.env"
FRONTEND_MODE="{{ diaries_frontend_mode }}"
SHARED_NETWORK="{{ diaries_shared_network_name }}"
SHARED_NGINX_CONTAINER="{{ diaries_shared_frontend_nginx_container_name }}"
SHARED_SOURCE_FILE="{{ diaries_shared_frontend_file }}"
SHARED_LOCATION_FILE="{{ diaries_shared_frontend_location_file }}"
SHARED_SYMLINK_TARGET="{{ diaries_shared_frontend_location_symlink_target }}"

require_file() {
    local file="$1"
    local description="$2"
    if [[ ! -f "${file}" ]]; then
        echo "ERROR: ${description} not found: ${file}" >&2
        exit 1
    fi
}

require_file "${COMPOSE_FILE}" "Diaries Compose file"
require_file "${ENV_FILE}" "Diaries environment file"

cd "${PROJECT_DIR}"

if [[ "${FRONTEND_MODE}" == "shared" ]]; then
    if ! docker network inspect "${SHARED_NETWORK}" >/dev/null 2>&1; then
        echo "ERROR: Shared Docker network '${SHARED_NETWORK}' does not exist." >&2
        echo "Start/install the infrastructure stack first." >&2
        exit 1
    fi

    if ! docker inspect "${SHARED_NGINX_CONTAINER}" >/dev/null 2>&1; then
        echo "ERROR: Shared Nginx container '${SHARED_NGINX_CONTAINER}' does not exist." >&2
        echo "Start/install the infrastructure stack first." >&2
        exit 1
    fi

    if [[ "$(docker inspect -f '{% raw %}{{.State.Running}}{% endraw %}' "${SHARED_NGINX_CONTAINER}")" != "true" ]]; then
        echo "ERROR: Shared Nginx container '${SHARED_NGINX_CONTAINER}' is not running." >&2
        exit 1
    fi

    require_file "${SHARED_SOURCE_FILE}" "Diaries shared Nginx route source"
fi

echo "Validating Diaries Docker Compose configuration..."
docker compose --file "${COMPOSE_FILE}" --env-file "${ENV_FILE}" config --quiet

echo "Pulling configured Diaries images..."
docker compose --file "${COMPOSE_FILE}" --env-file "${ENV_FILE}" pull

echo "Starting Diaries services..."
docker compose --file "${COMPOSE_FILE}" --env-file "${ENV_FILE}" \
    up --detach --remove-orphans --wait

if [[ "${FRONTEND_MODE}" == "shared" ]]; then
    echo "Activating Diaries routes in shared Nginx..."
    ln -sfn "${SHARED_SYMLINK_TARGET}" "${SHARED_LOCATION_FILE}"

    if ! docker exec "${SHARED_NGINX_CONTAINER}" nginx -t; then
        echo "ERROR: Shared Nginx configuration is invalid; removing Diaries route." >&2
        rm -f "${SHARED_LOCATION_FILE}"
        exit 1
    fi

    docker exec "${SHARED_NGINX_CONTAINER}" nginx -s reload
fi

echo "Diaries stack started successfully."
