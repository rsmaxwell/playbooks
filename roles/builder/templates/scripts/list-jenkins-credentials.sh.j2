#!/usr/bin/env bash
set -euo pipefail

cd ~/projects/builder
host="{{ jenkins_ssh_host }}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

required_vars=(
  CREDENTIAL_ID
  DOCKER_USERNAME
  DOCKER_PASSWORD
  DOCKER_DESCRIPTION
)

for var in "${required_vars[@]}"; do
  if [ -z "${!var:-}" ]; then
    echo "ERROR: ${var} is not set or empty" >&2
    exit 1
  fi
done

cat groovy/list-jenkins-credentials.groovy | ssh "${host}" groovy =
