#!/usr/bin/env bash
set -euo pipefail

cd ~/projects/builder
host="{{ jenkins_ssh_host }}"

export CREDENTIAL_ID='docker-registry-creds'
export DOCKER_USERNAME='{{ docker_username }}'
export DOCKER_PASSWORD='xxxxxxxxxxxxxxxxxxxx'
export DOCKER_DESCRIPTION='Docker registry credentials'

output=""
ssh_rc=0

set +e
output="$(
  ssh "${host}" groovy = \
    "${CREDENTIAL_ID}" \
    "${DOCKER_USERNAME}" \
    "${DOCKER_PASSWORD}" \
    "${DOCKER_DESCRIPTION}" \
    < groovy/update-jenkins-credentials.groovy 2>&1
)"
ssh_rc=$?
set -e

printf '%s\n' "$output" >&2

if grep -q "already up to date" <<<"$output"; then
  exit 0
elif grep -q "Created credential" <<<"$output"; then
  exit 1
elif grep -q "Updated credential" <<<"$output"; then
  exit 1
else
  exit 2
fi