#!/bin/bash

set -euo pipefail

INFRASTRUCTURE_PROJECT_DIR="{{ infrastructure_project_dir }}"
NGINX_SOURCE_FILE="{{ jenkins_nginx_source_file }}"
NGINX_LOCATION_FILE="{{ jenkins_nginx_location_file }}"
NGINX_SYMLINK_TARGET="{{ jenkins_nginx_location_symlink_target }}"

if [[ ! -f "${NGINX_SOURCE_FILE}" ]]; then
    echo "ERROR: Jenkins Nginx source file '${NGINX_SOURCE_FILE}' does not exist." >&2
    echo "Run the Builder Ansible playbook before starting Jenkins." >&2
    exit 1
fi

echo "Check the 'jenkins' deployment exists"
output=$(kubectl get deployment jenkins -o json 2>&1) || {
    echo "The 'jenkins' deployment was not found"
    echo "${output}"
    exit 0
}

echo "Check the current number of replicas"
replicas=$(jq -r '.spec.replicas' <<< "${output}")
if [[ "${replicas}" -eq 1 ]]; then
    echo "'replicas' already set to 1"
else
    echo "Start the Jenkins deployment"
    kubectl scale --replicas=1 deployment/jenkins
fi

echo "Wait for the Jenkins deployment"
kubectl wait deployment jenkins --for=condition=Available=True --timeout=5m

echo "Wait until Jenkins is ready"
kubectl wait --for=condition=ready pod --selector=app=jenkins --timeout=5m

echo "Jenkins is now available"
sleep 3

echo "Activate the Jenkins route in shared Nginx"
ln -sfn "${NGINX_SYMLINK_TARGET}" "${NGINX_LOCATION_FILE}"

cd "${INFRASTRUCTURE_PROJECT_DIR}"

if ! docker compose exec -T nginx nginx -t; then
    echo "ERROR: Shared Nginx configuration is invalid; removing Jenkins route." >&2
    rm -f "${NGINX_LOCATION_FILE}"
    exit 1
fi

docker compose exec -T nginx nginx -s reload
