
[Unit]
Description=The Jenkins service
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=richard
Group=docker
WorkingDirectory={{ builder_project_dir }}/scripts
ExecStart={{ builder_project_dir }}/scripts/start.sh
ExecStop=-{{ builder_project_dir }}/scripts/stop.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
