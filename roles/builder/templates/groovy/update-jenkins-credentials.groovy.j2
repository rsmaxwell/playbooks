import com.cloudbees.plugins.credentials.CredentialsScope
import com.cloudbees.plugins.credentials.SystemCredentialsProvider
import com.cloudbees.plugins.credentials.domains.Domain
import com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl

try {
    if (args.length < 3) {
        System.err.println("Usage: groovy = <credentialId> <username> <password> [description]")
        return 2
    }

    def credentialId = args[0]
    def newUsername = args[1]
    def newPassword = args[2]
    def newDescription = args.length >= 4 ? args[3..-1].join(' ') : null

    def provider = SystemCredentialsProvider.getInstance()
    def store = provider.getStore()
    def domain = Domain.global()

    def existing = provider.getCredentials().find { c ->
        c instanceof UsernamePasswordCredentialsImpl && c.id == credentialId
    }

    if (existing == null) {
        def created = new UsernamePasswordCredentialsImpl(
            CredentialsScope.GLOBAL,
            credentialId,
            newDescription,
            newUsername,
            newPassword
        )

        boolean added = store.addCredentials(domain, created)
        if (!added) {
            System.err.println("Failed to create credential '${credentialId}'")
            return 2
        }

        provider.save()
        println "Created credential '${credentialId}' successfully"
        return 1
    }

    def existingUsername = existing.username
    def existingPassword = existing.password?.getPlainText()
    def existingDescription = existing.description

    def effectiveNewDescription = newDescription ?: existingDescription

    boolean unchanged =
        existingUsername == newUsername &&
        existingPassword == newPassword &&
        existingDescription == effectiveNewDescription

    if (unchanged) {
        println "Credential '${credentialId}' already up to date"
        return 0
    }

    def replacement = new UsernamePasswordCredentialsImpl(
        existing.scope ?: CredentialsScope.GLOBAL,
        existing.id,
        effectiveNewDescription,
        newUsername,
        newPassword
    )

    boolean updated = store.updateCredentials(domain, existing, replacement)
    if (!updated) {
        System.err.println("Failed to update credential '${credentialId}'")
        return 2
    }

    provider.save()
    println "Updated credential '${credentialId}' successfully"
    return 1

} catch (Throwable t) {
    System.err.println("ERROR: ${t.class.name}: ${t.message}")
    t.printStackTrace(System.err)
    return 2
}