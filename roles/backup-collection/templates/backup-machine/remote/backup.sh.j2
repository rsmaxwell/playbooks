#!/bin/bash

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir" || exit 1


location="/@data/backup"
source=""
dest="${location}${source}"

host="richard-at-backup"

ssh ${host} mkdir -p ${dest}

rsync -avzh \
    --omit-dir-times \
    --itemize-changes \
    --delete --delete-excluded \
    --exclude-from=excludes-1 \
    --include-from=includes \
    --exclude-from=excludes-2 \
    /media/usb/@data/backup${source}/ ${host}:${dest}
