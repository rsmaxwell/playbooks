#!/bin/bash

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir" || exit 1


location="/media/usb/@data/backup/mars"
source="/root"
dest="${location}/home/${source}"

su {{ ansible_user }} --command "mkdir --parents --mode 777 ${dest}"

rsync -avzh \
    --omit-dir-times \
    --itemize-changes \
    --delete --delete-excluded \
    --owner --group --chown={{ ansible_user }}:{{ ansible_user }} \
    --exclude-from=excludes-1 \
    --include-from=includes \
    --exclude-from=excludes-2 \
    ${source}/ ${dest}