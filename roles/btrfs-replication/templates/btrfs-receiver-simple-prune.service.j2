[Unit]
Description=0040 Simplified Btrfs receiver retention (approved only)
After=network-online.target
ConditionPathExists=/etc/btrfs-snapshot-manager.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/btrfs-snapshot-manager --config /etc/btrfs-snapshot-manager.json receiver-simple-prune --max-delete {{ btrfs_simplified_receiver_prune_max_delete }}
TimeoutStartSec=2h
