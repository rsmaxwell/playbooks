{% if btrfs_native_sender_service_identity == 'dedicated' %}
[Unit]
Description=Push newest accepted-lineage Btrfs snapshot (0041 dedicated service account)
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/usr/local/libexec/btrfs-replication-sender-cycle-0041

[Service]
Type=oneshot
User=btrfs-send
Group=btrfs-send
ExecStart=/usr/bin/sudo -n /usr/local/libexec/btrfs-replication-sender-cycle-0041
TimeoutStartSec={{ btrfs_native_push_timeout_start_sec }}
{% else %}
[Unit]
Description=Push newest accepted-lineage Btrfs snapshot to off-site backup
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/usr/local/bin/btrfs-simplified-replication

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/bin/btrfs-simplified-replication sender cycle
TimeoutStartSec={{ btrfs_native_push_timeout_start_sec }}
{% endif %}