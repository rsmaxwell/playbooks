
[Unit]
Description=Infrastructure for webapps
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=richard
Group=docker
WorkingDirectory={{ infrastructure_project_dir }}
ExecStart=/usr/bin/docker compose up -d
ExecStop=-/usr/bin/docker compose down
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
